<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="004-create-kkd-rule" author="developer">
        <createTable tableName="kkd_rule">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_kkd_rule"
                             nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_kkd_rule_code"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="severity" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE kkd_rule
            ADD CONSTRAINT chk_kkd_rule_severity
            CHECK (severity IN ('CRITICAL', 'MAJOR', 'MINOR'));
        </sql>

        <rollback>
            <dropTable tableName="kkd_rule" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
