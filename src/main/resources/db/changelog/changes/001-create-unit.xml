<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="001-create-unit" author="developer">
        <createTable tableName="unit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_unit"
                             nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="unit"
                baseColumnNames="parent_id"
                constraintName="fk_unit_parent"
                referencedTableName="unit"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <sql>
            ALTER TABLE unit
            ADD CONSTRAINT chk_unit_not_own_parent
            CHECK (parent_id IS NULL OR parent_id &lt;&gt; id);
        </sql>

        <createIndex tableName="unit" indexName="idx_unit_parent_id">
            <column name="parent_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="unit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
